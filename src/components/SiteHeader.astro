---
// Slim sticky header: monogram + name, in-page nav, and the Resume button.
// The page's own white over the hero; frosted with a hairline once the page
// scrolls (Motion.astro toggles .is-scrolled from the [data-top-sentinel]).
import type { SiteData } from '../lib/athlete.ts';

interface Props {
  data: SiteData;
  links: { href: string; label: string }[];
}
const { data, links } = Astro.props;
---

<span id="top" class="top-sentinel" data-top-sentinel aria-hidden="true"></span>
<header class="site-header" data-header>
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/" aria-label={`${data.a.name.full}, home`}>
      <span class="site-header__mono" aria-hidden="true" data-initials={data.initials}></span>
      <span class="site-header__name" aria-hidden="true">{data.a.name.full}</span>
    </a>
    <nav class="site-header__nav" aria-label="Sections">
      <ul class="site-header__links">
        {
          links.map((l) => (
            <li class="site-header__link">
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--outline btn--sm site-header__resume" href="/resume/">Resume</a>
    </nav>
  </div>
</header>

<style>
  .top-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 48px;
    pointer-events: none;
  }
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: var(--page);
    transition:
      background-color 300ms var(--ease),
      box-shadow 300ms var(--ease),
      backdrop-filter 300ms var(--ease);
  }
  .site-header:global(.is-scrolled) {
    background: var(--glass);
    /* Prefixed first: the minifier keeps the last of the pair, and Chrome only reads the plain one. */
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    backdrop-filter: saturate(1.4) blur(16px);
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    text-decoration: none;
  }
  .site-header__mono {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--accent);
    border-radius: 50%;
    font-stretch: var(--stretch-condensed);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--text);
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  /* The initials are drawn, not written: the link's visible text is the name
     alone, which is what its accessible name starts with. */
  .site-header__mono::before {
    content: attr(data-initials);
  }
  .site-header__brand:hover .site-header__mono {
    border-color: var(--text);
    background: var(--text);
    color: var(--page);
  }
  .site-header__name {
    font-stretch: var(--stretch-condensed);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .site-header__links {
    display: none;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    /* A full 44px touch target; the underline stays close under the word. */
    min-height: 2.75rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    transition: color var(--duration) var(--ease);
  }
  .site-header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease);
  }
  .site-header__links a:hover {
    color: var(--text);
  }
  .site-header__links a:hover::after {
    transform: scaleX(1);
  }
  @media (max-width: 22rem) {
    .site-header__name {
      display: none;
    }
  }
  /* Tablets and up: the section links (a little closer together until there is room). */
  @media (min-width: 46rem) {
    .site-header__links {
      display: flex;
      gap: var(--space-5);
    }
    .site-header__nav {
      gap: var(--space-5);
    }
  }
  @media (min-width: 56rem) {
    .site-header__links,
    .site-header__nav {
      gap: var(--space-6);
    }
  }
</style>
